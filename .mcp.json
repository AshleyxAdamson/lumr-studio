{
  "mcpServers": {
    "lumr-studio": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "lumr-studio-server"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "HF_HUB_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
